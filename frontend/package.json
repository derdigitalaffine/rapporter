{
  "name": "familyos-web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "i18n:check": "node scripts/check-i18n.mjs",
    "release:check": "node scripts/check-familyos-release.mjs",
    "build": "npm run i18n:check && npm run release:check && vite build && vite build --config vite.superadmin.config.js && node scripts/stamp-service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "e2e": "playwright test",
    "e2e:visual": "playwright test e2e/visual-regression.spec.js e2e/calendar-grid-visual.spec.js",
    "e2e:visual:update": "playwright test e2e/visual-regression.spec.js e2e/calendar-grid-visual.spec.js --update-snapshots",
    "test:offline": "node --test tests/offline-*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@fontsource-variable/nunito": "latest",
    "@fortawesome/fontawesome-svg-core": "latest",
    "@fortawesome/free-solid-svg-icons": "latest",
    "@fortawesome/free-regular-svg-icons": "latest",
    "@fortawesome/react-fontawesome": "latest",
    "@uiw/react-markdown-preview": "latest",
    "@uiw/react-md-editor": "^4.1.2",
    "@zxing/browser": "latest",
    "@zxing/library": "latest",
    "bwip-js": "latest",
    "i18next": "latest",
    "qrcode": "latest",
    "react-i18next": "latest",
    "rehype-sanitize": "latest",
    "maplibre-gl": "6.14.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "fake-indexeddb": "^6.2.5"
  }
}
