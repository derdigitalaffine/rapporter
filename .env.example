TLS_MODE=internal
CADDYFILE=Caddyfile.selfsigned
DOMAIN=fam-uh-le.local
HTTP_PORT=80
HTTPS_PORT=443
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=fam-uh-le.local,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://fam-uh-le.local
CORS_ALLOWED_ORIGINS=https://fam-uh-le.local
TIME_ZONE=Europe/Berlin
INITIAL_LOCALE=de

POSTGRES_DB=famuhle
POSTGRES_USER=famuhle
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
INITIAL_FAMILY_NAME=Meine Familie
GUNICORN_WORKERS=3
INTEGRATION_SYNC_SECONDS=300

# Optional read-only calendar OAuth. Redirect URI:
# https://YOUR-DOMAIN[:HTTPS_PORT]/api/integration-oauth/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
