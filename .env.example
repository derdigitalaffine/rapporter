TLS_MODE=internal
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml
CADDYFILE=Caddyfile.selfsigned
DOMAIN=familyos.local
PUBLIC_SCHEME=https
PUBLIC_HOST=familyos.local
PUBLIC_PORT=443
APP_URL=https://familyos.local
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=familyos.local,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://familyos.local
CORS_ALLOWED_ORIGINS=https://familyos.local
TIME_ZONE=Europe/Berlin
INITIAL_LOCALE=de

# Auth-abuse hardening. A separate random HMAC key is recommended; blank/unset
# falls back to DJANGO_SECRET_KEY.
#
# FamilyOS uses a small dedicated proxy network so Django can trust exactly the
# pinned Caddy peer instead of an entire Docker subnet. The dynamic allocation
# range occupies only the lower half of the /28; Caddy sits in the upper half
# and therefore cannot collide with a dynamically assigned backend address.
#
# If FAMILYOS_PROXY_SUBNET is changed because of a local Docker network conflict,
# keep FAMILYOS_PROXY_DYNAMIC_RANGE inside that subnet, keep FAMILYOS_CADDY_IP
# outside the dynamic range, and keep AUTH_TRUSTED_PROXY_CIDRS aligned with the
# Caddy address (/32). scripts/setup.sh chooses a free candidate automatically.
AUTH_ABUSE_HMAC_KEY=
FAMILYOS_PROXY_SUBNET=172.28.254.0/28
FAMILYOS_PROXY_DYNAMIC_RANGE=172.28.254.0/29
FAMILYOS_CADDY_IP=172.28.254.14
AUTH_TRUSTED_PROXY_CIDRS=172.28.254.14/32
AUTH_ABUSE_IPV4_PREFIX=32
AUTH_ABUSE_IPV6_PREFIX=64
AUTH_ABUSE_RETENTION_SECONDS=86400

POSTGRES_DB=famuhle
POSTGRES_USER=famuhle
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Global platform administrator; intentionally not a member of a family tenant.
DJANGO_SUPERUSER_USERNAME=superadmin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# First family tenant and its independent owner login.
INITIAL_FAMILY_NAME=Meine Familie
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-with-a-different-strong-password
GUNICORN_WORKERS=3
INTEGRATION_SYNC_SECONDS=300

# Transactional email. Safe default: disabled/no external delivery.
# For production SMTP set EMAIL_BACKEND to Django's SMTP backend and fill the host values.
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=FamilyOS <noreply@familyos.local>
SERVER_EMAIL=FamilyOS <noreply@familyos.local>
EMAIL_REPLY_TO=

# Example production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=familyos@example.com
# EMAIL_HOST_PASSWORD=replace-with-smtp-secret
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=FamilyOS <familyos@example.com>

# Optional read-only calendar OAuth. Redirect URI:
# ${APP_URL}/api/integration-oauth/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Optional Web Push. The setup wizard can generate these automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Reverse-proxy mode (TLS terminates before FamilyOS) uses these values instead:
# TLS_MODE=proxy
# COMPOSE_FILE=docker-compose.yml
# CADDYFILE=Caddyfile.proxy
# DOMAIN=familyos.example.com
# PUBLIC_SCHEME=https
# PUBLIC_HOST=familyos.example.com
# PUBLIC_PORT=443
# APP_URL=https://familyos.example.com
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
