TLS_MODE=internal
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml
CADDYFILE=Caddyfile.selfsigned
DOMAIN=familyos.local
PUBLIC_SCHEME=https
PUBLIC_HOST=familyos.local
PUBLIC_PORT=443
APP_URL=https://familyos.local
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=familyos.local,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://familyos.local
CORS_ALLOWED_ORIGINS=https://familyos.local
TIME_ZONE=Europe/Berlin
INITIAL_LOCALE=de

# Optional auth-abuse hardening. A separate random HMAC key is recommended;
# blank/unset falls back to DJANGO_SECRET_KEY. The official compose topology
# always trusts only its dedicated Caddy /32 and appends any additional CIDRs
# listed in AUTH_TRUSTED_PROXY_CIDRS. Add only reverse proxies you operate.
AUTH_ABUSE_HMAC_KEY=
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_ABUSE_IPV4_PREFIX=32
AUTH_ABUSE_IPV6_PREFIX=64
AUTH_ABUSE_RETENTION_SECONDS=86400
# Advanced: change both values only if the default isolated edge subnet conflicts
# with another Docker/network route on this host.
AUTH_PROXY_NETWORK_CIDR=172.30.255.0/29
AUTH_PROXY_IPV4=172.30.255.2

POSTGRES_DB=famuhle
POSTGRES_USER=famuhle
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Global platform administrator; intentionally not a member of a family tenant.
DJANGO_SUPERUSER_USERNAME=superadmin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# First family tenant and its independent owner login.
INITIAL_FAMILY_NAME=Meine Familie
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-with-a-different-strong-password
GUNICORN_WORKERS=3
INTEGRATION_SYNC_SECONDS=300

# Optional read-only calendar OAuth. Redirect URI:
# ${APP_URL}/api/integration-oauth/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Optional Web Push. The setup wizard can generate these automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Reverse-proxy mode (TLS terminates before FamilyOS) uses these values instead:
# TLS_MODE=proxy
# COMPOSE_FILE=docker-compose.yml
# CADDYFILE=Caddyfile.proxy
# DOMAIN=familyos.example.com
# PUBLIC_SCHEME=https
# PUBLIC_HOST=familyos.example.com
# PUBLIC_PORT=443
# APP_URL=https://familyos.example.com
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# AUTH_TRUSTED_PROXY_CIDRS=10.0.0.10/32  # optional upstream proxy before Caddy
